<Window x:Class="RimTrans.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="❓ 使用教程 — RimTranslator" Height="680" Width="800"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#E8E0CE">
    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#3B3226"/>
        <SolidColorBrush x:Key="TextSub" Color="#7A6E58"/>
        <SolidColorBrush x:Key="Accent" Color="#8C4A1F"/>
        <SolidColorBrush x:Key="Panel" Color="#F2EBDA"/>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8C4A1F"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5E6B3C"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,12,0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="边缘译者 RimTranslator" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
            <TextBlock Text="RimWorld 离线翻译提取工具 · 完全免费 · 开源 · 本地运行" Style="{StaticResource Sub}" Margin="0,2,0,0"/>

            <TextBlock Text="📌 五步上手" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}" Text="1. 扫描：顶部选来源（创意工坊/本地/自定义）→ 点「⟳ 刷新列表」；找不到已订阅的模组时，点「⚙ 目录…」核对工坊目录（支持多个 Steam 库，可自动检测）"/>
            <TextBlock Style="{StaticResource Body}" Text="2. 设置：选游戏版本（如 1.6）与目标语言（要翻译成什么语言；提取以 Mod 的 English 为源）"/>
            <TextBlock Style="{StaticResource Body}" Text="3. 选择 Mod：搜索过滤（可勾选「隐藏翻译Mod」排除已有汉化），然后右键列表或在 ③ 区选操作："/>
            <TextBlock Style="{StaticResource Sub}" Text="     · 📝 提取：只生成待翻译模板（EN 注释 + TODO），写入 Mod 自己的 Languages"/>
            <TextBlock Style="{StaticResource Sub}" Text="     · 🤖 提取并AI翻译：提取 → 术语回填 → AI 翻译 → 审阅 → 写入该 Mod 的 Languages"/>
            <TextBlock Style="{StaticResource Sub}" Text="     · 📦 生成独立汉化Mod：同上，但输出为一个可上传创意工坊的全新汉化 Mod 文件夹（作者署名用「译者名」；描述保留原 Mod 内容并注明原作者）"/>
            <TextBlock Style="{StaticResource Body}" Text="4. 翻译AI（④ 区）：选供应商/填密钥；Player2 免密钥（先启动登录其桌面端）"/>
            <TextBlock Style="{StaticResource Body}" Text="5. 审阅写入：对照表逐条检查，双击译文可修改 → 「确认写入」→ 完成"/>

            <TextBlock Text="🤖 翻译AI 配置（免费渠道推荐）" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}" Text="· 首选 Player2（默认，免密钥）：先从"/>
            <TextBlock Margin="14,2,0,0">
                <Hyperlink NavigateUri="https://player2.game/" RequestNavigate="Link_RequestNavigate"
                           Foreground="#B45309" FontWeight="Bold">官网 player2.game 下载</Hyperlink>
                <Run Text="并启动登录 Player2 桌面端，回来点「测试连接」即可"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Body}" Text="· 免费额度推荐 硅基流动 SiliconFlow："/>
            <TextBlock Margin="14,2,0,0">
                <Hyperlink NavigateUri="https://cloud.siliconflow.cn/i/hazSLAR1" RequestNavigate="Link_RequestNavigate"
                           Foreground="#B45309" FontWeight="Bold">点此直达，送免费额度</Hyperlink>
                <Run Text="（注册后在「密钥」里填 SiliconFlow 的 API Key，软件已内置其端点，模型可填 Qwen/Qwen2.5-7B-Instruct 等免费模型）"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Body}" Text="· 其他供应商（Gemini/OpenAI/DeepSeek/Grok/GLM/OpenRouter/SiliconFlow）：切换后填 API 密钥，端点和默认模型自动填好"/>
            <TextBlock Style="{StaticResource Body}" Text="· 本地模型：LM Studio (1234) / Ollama (11434) / vLLM (8000)，免密钥"/>
            <TextBlock Style="{StaticResource Body}" Text="· 自定义：任意 OpenAI 兼容端点；只填域名也行，工具自动补全路径（405 会提示后重试）"/>

            <TextBlock Text="🔒 隐私承诺" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}" Text="你的 API 密钥只保存在你自己电脑内。"/>

            <TextBlock Text="📚 词库管理" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}" Text="· 自定义词库：你的私人词库，翻译时优先于官方术语库。觉得某条官方译名不对？添加同名英文词条、填入你的译法即可顶掉官方——无需删除任何东西"/>
            <TextBlock Style="{StaticResource Body}" Text="· 官方术语库：只读查询，来源为游戏本体 + 全部 DLC 官方翻译，点「载入官方术语库」后可搜索"/>

            <TextBlock Text="🛡 安全机制" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}" Text="· 覆盖任何文件前自动生成 .bak 备份（同目录同名 .xml.bak）"/>
            <TextBlock Style="{StaticResource Body}" Text="· 写创意工坊目录前弹覆盖警告，确认才执行；工具不修改游戏本体文件"/>

            <TextBlock Text="❓ 常见问题" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}" Text="问：提取时提示没有 English/Keyed？"/>
            <TextBlock Style="{StaticResource Sub}" Text="答：该 Mod 没有英文源文本（或藏在版本子目录）。英文是提取基准，没有就无法生成翻译模板，属正常跳过。"/>
            <TextBlock Style="{StaticResource Body}" Text="问：为什么有些文本提取不到？"/>
            <TextBlock Style="{StaticResource Sub}" Text="答：① 少数 PatchOperation 操作类型（FindMod/Sequence/Conditional 等）暂不支持，用它们的 Mod 会漏掉那部分文本；② Mod 作者没做本地化支持——文本硬编码在 C# 代码里、或直接写死在界面里没走翻译键，这类内容任何提取工具都拿不到（游戏内提取器也一样），只能联系 Mod 作者添加翻译键；③ 代码动态注册的 Def 离线抓不到。"/>
            <TextBlock Style="{StaticResource Body}" Text="问：我是 Modder，只做了简中，能翻成日语放回自己的 Mod 吗？"/>
            <TextBlock Style="{StaticResource Sub}" Text="答：可以。目标语言选 日本語，提取翻译后选「原 Mod 目录」输出，即写入你的 Mod 的 Languages\Japanese\。"/>

            <TextBlock Text="🙏 致谢" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}">
                <Run Text="本工具的提取逻辑（ExtractKey / DefInjected 生成 / 注释格式等）基于创意工坊模组 "/>
                <Hyperlink NavigateUri="https://steamcommunity.com/sharedfiles/filedetails/?id=3026452122" RequestNavigate="Link_RequestNavigate"
                           Foreground="#B45309">Extract translation</Hyperlink>
                <Run Text="（作者 HaiLuan）对齐实现，感谢原作者！"/>
            </TextBlock>

            <TextBlock Text="💬 支持与反馈" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Body}" Text="以下渠道都可从主界面底部链接直达："/>
            <TextBlock Margin="14,4,0,0">
                <Hyperlink NavigateUri="https://github.com/Maiya0126/rimtranslator" RequestNavigate="Link_RequestNavigate">⭐ GitHub 开源仓库</Hyperlink>
                <Run Text="　（源码 / 问题反馈 / 版本下载）"/>
            </TextBlock>
            <TextBlock Margin="14,2,0,0" Text="👥 QQ群 1568455（使用帮助、汉化交流，群号可点击主界面底部自动复制）"/>
            <TextBlock Margin="14,2,0,0">
                <Hyperlink NavigateUri="https://afdian.com/a/maiya0126" RequestNavigate="Link_RequestNavigate"
                           Foreground="#BE3455">💖 爱发电支持作者</Hyperlink>
                <Run Text="　如果工具帮到了你，欢迎请作者喝杯奶茶"/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>
