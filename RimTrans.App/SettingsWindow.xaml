<Window x:Class="RimTrans.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ 目录设置 — RimTranslator" Height="560" Width="780"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#E8E0CE"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#F2EBDA"/>
        <SolidColorBrush x:Key="PanelLight" Color="#DCD2B8"/>
        <SolidColorBrush x:Key="Border" Color="#B8AA88"/>
        <SolidColorBrush x:Key="TextMain" Color="#3B3226"/>
        <SolidColorBrush x:Key="TextSub" Color="#7A6E58"/>
        <SolidColorBrush x:Key="Accent" Color="#8C4A1F"/>
        <SolidColorBrush x:Key="AccentBg" Color="#EAD9C2"/>
        <SolidColorBrush x:Key="Warn" Color="#B45309"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#F2EBDA"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="目录设置（修改后保存会自动重新扫描）" Style="{StaticResource GroupTitle}" FontSize="14"/>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <TextBlock Text="创意工坊目录（支持多个 Steam 库）" Style="{StaticResource GroupTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="主工坊目录" Style="{StaticResource FieldLabel}" Width="70"/>
                        <TextBox x:Name="TxtWorkshop" Width="440" TextChanged="TxtWorkshop_TextChanged"/>
                        <Button x:Name="BtnBrowseWorkshop" Content="浏览…" Click="BtnBrowseWorkshop_Click"/>
                        <Button x:Name="BtnDetect" Content="⟳ 自动检测" Click="BtnDetect_Click"
                                ToolTip="扫描注册表和所有 Steam 库，找出含 RimWorld 工坊内容的目录"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtWorkshopHint" Foreground="{StaticResource Warn}" FontStyle="Italic"
                               FontSize="11" Margin="76,0,0,0" TextWrapping="Wrap"/>
                    <ListBox x:Name="LstExtraWorkshop" MinHeight="52" MaxHeight="110" Margin="76,6,0,6"
                             Background="#F2EBDA" BorderBrush="{StaticResource Border}" BorderThickness="1"
                             FontSize="11" Foreground="{StaticResource TextSub}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnAddExtra" Content="＋ 添加其他库…" Click="BtnAddExtra_Click"
                                ToolTip="添加第二个 Steam 库的工坊目录（扫描时会一并读取）"/>
                        <Button x:Name="BtnRemoveExtra" Content="－ 移除选中" Click="BtnRemoveExtra_Click"/>
                        <TextBlock Text="其他库的模组同样会出现在列表里（来源显示为 Workshop）" Style="{StaticResource FieldLabel}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <TextBlock Text="本地目录" Style="{StaticResource GroupTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="本地 Mods" Style="{StaticResource FieldLabel}" Width="70"/>
                        <TextBox x:Name="TxtLocal" Width="440"/>
                        <Button x:Name="BtnBrowseLocal" Content="浏览…" Click="BtnBrowseLocal_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="游戏 Data" Style="{StaticResource FieldLabel}" Width="70"/>
                        <TextBox x:Name="TxtData" Width="440"/>
                        <Button x:Name="BtnBrowseData" Content="浏览…" Click="BtnBrowseData_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="💾 保存并重扫" FontWeight="Bold" Padding="20,6"
                    Background="#DDE3C8" BorderBrush="#5E6B3C" Foreground="#5E6B3C"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
