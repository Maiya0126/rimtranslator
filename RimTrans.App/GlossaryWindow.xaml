<Window x:Class="RimTrans.App.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📚 词库管理 — RimTranslator" Height="640" Width="940"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#E8E0CE"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#E8E0CE"/>
        <SolidColorBrush x:Key="Panel" Color="#F2EBDA"/>
        <SolidColorBrush x:Key="PanelLight" Color="#DCD2B8"/>
        <SolidColorBrush x:Key="Border" Color="#B8AA88"/>
        <SolidColorBrush x:Key="TextMain" Color="#3B3226"/>
        <SolidColorBrush x:Key="TextSub" Color="#7A6E58"/>
        <SolidColorBrush x:Key="Accent" Color="#8C4A1F"/>
        <SolidColorBrush x:Key="AccentBg" Color="#EAD9C2"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#F2EBDA"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="RowBackground" Value="#F2EBDA"/>
            <Setter Property="AlternatingRowBackground" Value="#EAE2CF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelLight}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="14,7" CornerRadius="6,6,0,0" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 页1：自定义词库 -->
            <TabItem Header="✏️ 自定义词库（可编辑）">
                <DockPanel Margin="4,10,4,4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="使用指南：这里是你的私人词库，翻译时优先级最高（高于云端与官方术语库）。添加词条后点「保存」持久化（按语言分库，存于 %APPDATA%\RimTranslator\）。英文原文与官方译名相同时即为覆盖：例如你觉得官方把某词翻得不好，直接添加同名词条填写你的译法即可顶掉官方译名，无需删除任何东西。可用「导出JSON / 导入JSON」与其他译者共享词库。"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnAdd" Content="＋ 添加词条" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnDelete" Content="🗑 删除选中" Margin="8,0,0,0" Click="BtnDelete_Click"/>
                        <Button x:Name="BtnImport" Content="📥 导入已有翻译…" Margin="8,0,0,0"
                                Background="{StaticResource AccentBg}" BorderBrush="{StaticResource Accent}"
                                Foreground="{StaticResource Accent}" Click="BtnImport_Click"
                                ToolTip="选择一个汉化包/翻译Mod的 Languages\&lt;语言&gt; 目录（或其中的 Keyed/DefInjected 目录），自动从 EN 注释+译文配对导入词库。旧 Mod 更新后把旧翻译喂进来，大部分条目直接回填不再请求 AI"/>
                        <Button x:Name="BtnExportJson" Content="📤 导出JSON…" Margin="8,0,0,0" Click="BtnExportJson_Click"
                                ToolTip="把当前自定义词库导出为 JSON 文件，可发给其他译者/汉化组共享"/>
                        <Button x:Name="BtnImportJson" Content="📥 导入JSON…" Margin="8,0,0,0" Click="BtnImportJson_Click"
                                ToolTip="导入其他译者导出的词库 JSON（与本工具导出格式一致），合并进当前词库"/>
                        <Button x:Name="BtnSave" Content="💾 保存" Margin="8,0,0,0" FontWeight="Bold"
                                Background="{StaticResource AccentBg}" BorderBrush="{StaticResource Accent}"
                                Foreground="{StaticResource Accent}" Click="BtnSave_Click"/>
                        <TextBlock x:Name="TxtStat" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{StaticResource TextSub}"/>
                    </StackPanel>
                    <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="英文原文" Binding="{Binding En}" Width="280"/>
                            <DataGridTextColumn Header="我的译法" Binding="{Binding Translation}" Width="280"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- 页2：官方术语库（本地 Data） -->
            <TabItem Header="📖 官方术语库（本地 Data）">
                <DockPanel Margin="4,10,4,4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="术语来源：你电脑上游戏本体与全部 DLC 的官方翻译（Data 目录 tar），EN 原文→译文。仅供查询参考；觉得某条官方译名不合适时，请到「自定义词库」添加同名词条覆盖它。"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnLoadOfficial" Content="📥 载入官方术语库" FontWeight="Bold"
                                Background="{StaticResource AccentBg}" BorderBrush="{StaticResource Accent}"
                                Foreground="{StaticResource Accent}" Click="BtnLoadOfficial_Click"
                                ToolTip="扫描 Data 目录全部 DLC 官方翻译（约七千条），载入下方列表供查询。首次约需数十秒。"/>
                        <TextBlock x:Name="TxtOfficialStat" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSub}" Text="尚未载入"/>
                        <TextBox x:Name="TxtOfficialSearch" Width="240" Margin="16,0,0,0"
                                 TextChanged="TxtOfficialSearch_TextChanged" ToolTip="输入关键字过滤（英文或译名）"/>
                    </StackPanel>
                    <DataGrid x:Name="GridOfficial" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="英文原文" Binding="{Binding En}" Width="320"/>
                            <DataGridTextColumn Header="官方译名" Binding="{Binding Translation}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- 页3：云端词库 -->
            <TabItem Header="☁️ 云端词库（GitHub）">
                <DockPanel Margin="4,10,4,4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="维护者发布在 GitHub 仓库的官方译名词库（defName→中文，九千余条，覆盖本体+全部 DLC）。词库更新后所有用户点「从云端刷新」即可热更新，无需等软件版本；无网时使用上次缓存（7 天内不重复拉取）。翻译时优先级：自定义词库 > 云端词库 > 本地官方库。"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnCloudRefresh" Content="🔄 从云端刷新" FontWeight="Bold"
                                Background="{StaticResource AccentBg}" BorderBrush="{StaticResource Accent}"
                                Foreground="{StaticResource Accent}" Click="BtnCloudRefresh_Click"
                                ToolTip="从 GitHub Raw 拉取最新词库并缓存到本地"/>
                        <TextBlock x:Name="TxtCloudStat" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSub}" Text="未加载（翻译时自动拉取）"/>
                        <TextBox x:Name="TxtCloudSearch" Width="240" Margin="16,0,0,0"
                                 TextChanged="TxtCloudSearch_TextChanged" ToolTip="输入 defName 或中文过滤"/>
                    </StackPanel>
                    <DataGrid x:Name="GridCloud" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="defName" Binding="{Binding Key}" Width="320"/>
                            <DataGridTextColumn Header="官方译名" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnClose" Content="关闭" Padding="20,5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
