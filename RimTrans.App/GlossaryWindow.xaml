<Window x:Class="RimTrans.App.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📚 词库管理 — RimTranslator" Height="640" Width="900"
        Icon="icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1E293B"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="TextMain" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSub" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent" Color="#22C55E"/>
        <SolidColorBrush x:Key="Info" Color="#38BDF8"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="RowBackground" Value="{StaticResource Panel}"/>
            <Setter Property="AlternatingRowBackground" Value="#243247"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#182334"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="14,7" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#243247"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 页1：自定义词库 -->
            <TabItem Header="✏️ 自定义词库（可编辑）">
                <DockPanel Margin="4,10,4,4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="使用指南：这里是你的私人词库，翻译时优先于官方术语库生效。添加词条后点「保存」持久化（按语言分库，存于 %APPDATA%\RimTrans\）。英文原文与官方译名相同时即为覆盖：例如你觉得官方把某词翻得不好，直接添加同名词条填写你的译法即可顶掉官方译名，无需删除任何东西。"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnAdd" Content="＋ 添加词条" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnDelete" Content="🗑 删除选中" Margin="8,0,0,0" Click="BtnDelete_Click"/>
                        <Button x:Name="BtnSave" Content="💾 保存" Margin="8,0,0,0" FontWeight="Bold"
                                Background="#14532D" BorderBrush="{StaticResource Accent}" Click="BtnSave_Click"/>
                        <TextBlock x:Name="TxtStat" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{StaticResource TextSub}"/>
                    </StackPanel>
                    <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="英文原文" Binding="{Binding En}" Width="280"/>
                            <DataGridTextColumn Header="我的译法" Binding="{Binding Translation}" Width="280"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- 页2：官方术语库 -->
            <TabItem Header="📖 官方术语库（只读查询）">
                <DockPanel Margin="4,10,4,4">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="术语来源：游戏本体与全部 DLC 的官方翻译（Data 目录）。仅供查询参考，不可编辑；觉得某个官方译名不合适时，请到「自定义词库」添加同名词条覆盖它。"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnLoadOfficial" Content="📥 载入官方术语库" FontWeight="Bold"
                                Background="#14532D" BorderBrush="{StaticResource Accent}" Click="BtnLoadOfficial_Click"
                                ToolTip="扫描 Data 目录全部 DLC 官方翻译（本体+DLC，约数千条），载入下方列表供查询。首次约需数十秒。"/>
                        <TextBlock x:Name="TxtOfficialStat" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{StaticResource TextSub}" Text="尚未载入"/>
                        <TextBox x:Name="TxtOfficialSearch" Width="240" Margin="16,0,0,0"
                                 TextChanged="TxtOfficialSearch_TextChanged" ToolTip="输入关键字过滤（英文或译名）"/>
                    </StackPanel>
                    <DataGrid x:Name="GridOfficial" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="英文原文" Binding="{Binding En}" Width="320"/>
                            <DataGridTextColumn Header="官方译名" Binding="{Binding Translation}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnClose" Content="关闭" Padding="20,5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
