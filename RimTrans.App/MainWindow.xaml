<Window x:Class="RimTrans.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="边缘译者 RimTranslator — RimWorld 翻译提取工具" Height="850" Width="1240"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ═══ RimTranslator 深色主题（slate 深空 + 绿色行动色，游戏工具风）═══ -->
        <SolidColorBrush x:Key="Bg" Color="#0F172A"/>
        <SolidColorBrush x:Key="Panel" Color="#1E293B"/>
        <SolidColorBrush x:Key="PanelLight" Color="#334155"/>
        <SolidColorBrush x:Key="Border" Color="#334155"/>
        <SolidColorBrush x:Key="TextMain" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSub" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Accent" Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentDark" Color="#16A34A"/>
        <SolidColorBrush x:Key="Info" Color="#38BDF8"/>
        <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource PanelLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="4,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource PanelLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="RowBackground" Value="{StaticResource Panel}"/>
            <Setter Property="AlternatingRowBackground" Value="#243247"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#182334"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#0B1120"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Margin" Value="10,0,4,0"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Info}"/>
            <Setter Property="TextDecorations" Value="None"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- ① 扫描 -->
            <RowDefinition Height="*"/>    <!-- ② Mod 列表 -->
            <RowDefinition Height="Auto"/> <!-- ③ 输出 -->
            <RowDefinition Height="Auto"/> <!-- ④ 翻译AI -->
            <RowDefinition Height="Auto"/> <!-- ⑤ 进度+日志 -->
            <RowDefinition Height="Auto"/> <!-- 底部链接栏 -->
        </Grid.RowDefinitions>

        <!-- ═══ ① 扫描 ═══ -->
        <Border Grid.Row="0" Style="{StaticResource GroupBorder}">
            <StackPanel>
                <TextBlock Text="① 扫描" Style="{StaticResource GroupTitle}"/>
                <WrapPanel>
                    <TextBlock Text="来源" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <CheckBox x:Name="ChkWorkshop" Content="创意工坊" IsChecked="True"/>
                    <CheckBox x:Name="ChkLocal" Content="本地 Mods" IsChecked="True"/>
                    <CheckBox x:Name="ChkData" Content="游戏本体" IsChecked="False"
                              ToolTip="官方 DLC 翻译已完备，默认不列出（术语库仍会读取 Data）"/>
                    <CheckBox x:Name="ChkCustom" Content="自定义" IsChecked="True"/>
                    <Button x:Name="BtnAddSource" Content="＋ 添加目录…" Margin="8,0,0,0" Click="BtnAddSource_Click"/>
                    <Button x:Name="BtnScan" Content="⟳ 刷新列表" FontWeight="Bold" Margin="8,0,0,0"
                            Background="#14532D" BorderBrush="{StaticResource Accent}" Click="BtnScan_Click"/>

                    <TextBlock Text="游戏版本" Style="{StaticResource FieldLabel}" FontWeight="Bold"/>
                    <ComboBox x:Name="CmbVersion" Width="72" SelectionChanged="CmbVersion_SelectionChanged"/>
                    <TextBlock Text="目标语言" Style="{StaticResource FieldLabel}" FontWeight="Bold"
                               ToolTip="要翻译成什么语言（以 Mod 的 English 为源）"/>
                    <ComboBox x:Name="CmbLanguage" Width="180" SelectionChanged="CmbLanguage_SelectionChanged"/>
                    <Button x:Name="BtnGlossary" Content="📚 词库管理…" Margin="14,0,0,0" Click="BtnGlossary_Click"
                            ToolTip="官方术语库（只读查询）+ 自定义词库（增删改）；同名词条可覆盖官方译名，翻译时自定义优先"/>
                    <Button x:Name="BtnHelp" Content="❓ 使用教程" Click="BtnHelp_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ ② 选择 Mod ═══ -->
        <Border Grid.Row="1" Style="{StaticResource GroupBorder}">
            <DockPanel>
                <TextBlock Text="② 选择 Mod" Style="{StaticResource GroupTitle}" DockPanel.Dock="Top"/>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" TextChanged="TxtSearch_TextChanged"
                             ToolTip="支持名称 / 包ID / 工坊ID 模糊搜索"/>
                    <CheckBox x:Name="ChkHideTranslation" Grid.Column="2" Content="隐藏翻译Mod" IsChecked="True"
                              Margin="12,0,0,0" Checked="ChkHideTranslation_Changed" Unchecked="ChkHideTranslation_Changed"
                              ToolTip="按名称关键词过滤掉翻译/汉化类 Mod（如 汉化/Chinese/Translation/简体/繁体/日化/韩化）"/>
                    <TextBlock x:Name="TxtCount" Grid.Column="3" Text="先点上方「刷新列表」" Foreground="{StaticResource TextSub}"
                               FontStyle="Italic" Margin="12,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Button x:Name="BtnExtract" Grid.Column="4" Content="▶ 提取" Padding="24,6" FontWeight="Bold"
                            Background="#14532D" BorderBrush="{StaticResource Accent}" Click="BtnExtract_Click"
                            ToolTip="提取 Keyed + DefInjected 待翻译文本（不做 AI 翻译）。也可右键列表。"/>
                </Grid>
                <DataGrid x:Name="GridMods" SelectionMode="Extended" SelectionUnit="FullRow"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          RowHeight="40">
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="{StaticResource Panel}" Foreground="{StaticResource TextMain}">
                            <MenuItem Header="提取（不做AI）" Click="BtnExtract_Click" FontWeight="Bold"/>
                            <MenuItem Header="翻译（提取 → 术语回填 → AI → 审阅）" Click="MenuTranslate_Click"/>
                            <MenuItem Header="翻译并生成独立汉化Mod" Click="MenuTranslateSkeleton_Click"/>
                            <Separator/>
                            <MenuItem Header="打开文件夹" Click="MenuOpenFolder_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="封面" Width="66" CanUserResize="False" CanUserReorder="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" ClipToBounds="True" Margin="2,1" Width="62" Height="36">
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="LowQuality"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="330"/>
                        <DataGridTextColumn Header="来源" Binding="{Binding SourceDisplay}" Width="56"/>
                        <DataGridTextColumn Header="包ID" Binding="{Binding PackageId}" Width="180"/>
                        <DataGridTextColumn Header="版本" Binding="{Binding VersionsDisplay}" Width="80"/>
                        <DataGridTextColumn Header="已有语言" Binding="{Binding LanguagesDisplay}" Width="*"/>
                        <DataGridTextColumn Header="工坊ID" Binding="{Binding PublishedFileId}" Width="92"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ═══ ③ 输出位置 ═══ -->
        <Border Grid.Row="2" Style="{StaticResource GroupBorder}">
            <StackPanel>
                <TextBlock Text="③ 输出位置" Style="{StaticResource GroupTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbOutModDir" Content="原 Mod 目录" IsChecked="True"
                                 ToolTip="写进所选 Mod 自己的 Languages 目录（最常用，提取完即用）。写工坊目录会弹覆盖警告并自动 .bak 备份。"/>
                    <RadioButton x:Name="RbOutCustom" Content="自定义目录"/>
                    <TextBox x:Name="TxtOutDir" Width="300"/>
                    <Button x:Name="BtnBrowseOut" Content="浏览…" Click="BtnBrowseOut_Click"/>
                    <RadioButton x:Name="RbOutSkeleton" Content="生成独立汉化Mod" Margin="18,0,0,0"
                                 ToolTip="另建一个全新的汉化 Mod（自动生成 About.xml 声明依赖原 Mod、LoadFolders.xml、Languages 目录），可直接发布创意工坊；输出目录用左侧「浏览」选择。"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ ④ 翻译AI ═══ -->
        <Border Grid.Row="3" Style="{StaticResource GroupBorder}">
            <StackPanel>
                <TextBlock Text="④ 翻译AI（术语回填后的剩余内容交给它）" Style="{StaticResource GroupTitle}"/>
                <WrapPanel>
                    <ComboBox x:Name="CmbProvider" Width="150" SelectionChanged="CmbProvider_SelectionChanged">
                        <ComboBoxItem Content="Player2（免密钥）" Tag="Player2"/>
                        <ComboBoxItem Content="Google Gemini" Tag="Google"/>
                        <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                        <ComboBoxItem Content="DeepSeek" Tag="DeepSeek"/>
                        <ComboBoxItem Content="Grok" Tag="Grok"/>
                        <ComboBoxItem Content="GLM" Tag="GLM"/>
                        <ComboBoxItem Content="OpenRouter" Tag="OpenRouter"/>
                        <ComboBoxItem Content="SiliconFlow" Tag="SiliconFlow"/>
                        <ComboBoxItem Content="本地模型" Tag="Local"/>
                        <ComboBoxItem Content="自定义" Tag="Custom"/>
                    </ComboBox>
                    <TextBlock Text="端点" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtEndpoint" Width="230" TextChanged="TxtEndpoint_TextChanged"/>
                    <TextBlock Text="密钥" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtApiKey" Width="150" TextChanged="TxtApiKey_TextChanged"/>
                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtModel" Width="130" TextChanged="TxtModel_TextChanged"/>
                    <Button x:Name="BtnTestConn" Content="测试连接" Click="BtnTestConn_Click"/>
                    <TextBlock x:Name="TxtPlayer2Hint" Text="ⓘ 需先启动并登录 Player2 桌面端（未启动无法翻译，可换其他供应商）"
                               Foreground="{StaticResource Warn}" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══ ⑤ 进度与日志 ═══ -->
        <Border Grid.Row="4" Style="{StaticResource GroupBorder}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⑤ 进度与日志" Style="{StaticResource GroupTitle}" Margin="0"/>
                    <Button x:Name="BtnClearLog" Grid.Column="1" Content="清空日志" Padding="10,2" Click="BtnClearLog_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtProgress" Text="就绪" VerticalAlignment="Center" FontWeight="Bold"
                               MinWidth="440" Foreground="{StaticResource Accent}"/>
                    <ProgressBar x:Name="Progress" Width="430" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
                <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Height="130" Background="#0B1120">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono" FontSize="12" Background="Transparent"
                             Foreground="#A7D7B8" BorderThickness="0" Padding="6"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ 底部链接栏 ═══ -->
        <Border Grid.Row="5" Background="#182334" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                CornerRadius="0,0,6,6" Padding="12,6" Margin="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="边缘译者 RimTranslator v1.0" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" Margin="0,0,14,0"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand">
                    <Hyperlink NavigateUri="https://github.com/maiya026/rimtranslator" RequestNavigate="Link_RequestNavigate">⭐ GitHub 开源</Hyperlink>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand">
                    <Hyperlink NavigateUri="https://afdian.com/a/maiya0126" RequestNavigate="Link_RequestNavigate"
                               Foreground="#F472B6">💖 爱发电支持作者</Hyperlink>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand" MouseLeftButtonDown="QQGroup_Click"
                           ToolTip="点击复制群号：1568455">
                    <Run Text="👥 QQ群 1568455" Foreground="{StaticResource Info}"/>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand">
                    <Hyperlink NavigateUri="https://steamcommunity.com/sharedfiles/filedetails/?id=3026452122" RequestNavigate="Link_RequestNavigate"
                               ToolTip="本工具提取逻辑基于该模组对齐实现，感谢原作者 HaiLuan">🙏 致谢 Extract translation</Hyperlink>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Cursor="Hand">
                    <Hyperlink NavigateUri="checkupdate" RequestNavigate="Link_RequestNavigate">⟳ 检查更新</Hyperlink>
                </TextBlock>
                <TextBlock Text="API 密钥仅存本机，不上传不回传" VerticalAlignment="Center" Foreground="#64748B"
                           FontStyle="Italic" Margin="18,0,0,0"
                           ToolTip="隐私承诺：密钥只保存在你电脑的 %APPDATA%\RimTrans\settings.json，开发者无法读取"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
